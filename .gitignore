RESUME.md

# Xcode — we version source files only, not the project / workspace
# (regenerate locally; see ios/README.md). User-specific xcuserdata
# always changes per machine; Pods/ would only matter if we add
# CocoaPods (we won't in v0).
ios/**/*.xcodeproj/
ios/**/*.xcworkspace/
ios/**/xcuserdata/
ios/**/build/
ios/**/DerivedData/
ios/**/.build/
ios/**/*.xcuserstate
ios/**/Pods/
