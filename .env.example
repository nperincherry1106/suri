ANTHROPIC_API_KEY=sk-ant-...

MS_CLIENT_ID=

# Get TELEGRAM_BOT_TOKEN from @BotFather on Telegram (`/newbot`).
TELEGRAM_BOT_TOKEN=
# Your own Telegram user id. DM @userinfobot to get it. Suri only responds to this id.
TELEGRAM_USER_ID=

# Public HTTPS URL where Suri serves the OAuth callback. Set in deploy
# environments (e.g. fly.toml). When set, first-time Outlook auth uses a
# one-tap magic link instead of the device-code fallback. Local dev can
# leave this blank — _token() falls back to the interactive browser flow.
# Must match the redirect URI registered in your Azure app:
#   <SURI_PUBLIC_URL>/connect/outlook/callback
SURI_PUBLIC_URL=

# Optional override if you want to register a different redirect URI than
# the SURI_PUBLIC_URL/connect/outlook/callback default.
# MS_REDIRECT_URI=

# Plaid (card/bank transactions). Dashboard: https://dashboard.plaid.com
# Use sandbox first; set PLAID_ENV=production when ready.
# Webhook URL (register in Plaid dashboard): <SURI_PUBLIC_URL>/plaid/webhook
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox | development | production
PLAID_ENV=sandbox