ANTHROPIC_API_KEY=sk-ant-...

# Telegram (primary chat surface). Create bot via @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=

# Headless mode: Outlook/Plaid auth prompts go to Telegram, not a browser popup.
# Required when running app.telegram_bot without a display (Fly, background terminal).
SURI_HEADLESS=1

MS_CLIENT_ID=

# Public HTTPS URL where Suri serves OAuth + Plaid Link pages.
# Fly: https://<app>.fly.dev — must match Azure redirect:
#   <SURI_PUBLIC_URL>/connect/outlook/callback
SURI_PUBLIC_URL=

# MS_REDIRECT_URI=

# Plaid — https://dashboard.plaid.com → Developers → Keys
# Use sandbox for testing; production (or Trial plan) for real banks.
# Webhook is registered automatically via /link/token/create — no dashboard step needed.
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox | development | production
PLAID_ENV=sandbox

# Gmail (optional, peer to Outlook)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
